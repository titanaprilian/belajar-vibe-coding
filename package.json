    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "mysql2": "^3.20.0"
  }
}
